#!/bin/sh
# Hook pre-push: blokuje --force bez swiezej migawki.
#
# Instalacja: python3 dev/hooki/zainstaluj.py
#
# Zwykly push przechodzi bez pytania. Blokowany jest tylko push, ktory
# NADPISUJE historie na zdalnym - bo tego nie da sie cofnac przez git.
# Wykrywamy go po tym, ze git podaje "delete" albo ze zdalny commit nie
# jest przodkiem lokalnego (czyli --force lub --force-with-lease).

KORZEN=$(git rev-parse --show-toplevel)
NISZCZACY=0

while read local_ref local_sha remote_ref remote_sha; do
    # kasowanie galezi
    case "$local_sha" in
        0000000*) NISZCZACY=1 ;;
    esac
    # nadpisanie historii: zdalny commit nie jest przodkiem lokalnego
    case "$remote_sha" in
        0000000*|"") ;;   # nowa galaz - nic nie nadpisuje
        *)
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                NISZCZACY=1
            fi
            ;;
    esac
done

[ "$NISZCZACY" = "0" ] && exit 0

echo ""
echo "  ██  PUSH NISZCZACY HISTORIE  ██"
echo ""
echo "  Ten push nadpisuje albo kasuje to, co jest na zdalnym."
echo "  Git tego nie cofnie."
echo ""

if python3 "$KORZEN/bakap.py" --sprawdz >/dev/null 2>&1; then
    echo "  Migawka jest swieza - przepuszczam."
    echo "  Gdyby cos poszlo zle: python3 bakap.py --lista"
    echo ""
    exit 0
fi

python3 "$KORZEN/bakap.py" --sprawdz 2>&1 | sed 's/^/  /'
echo ""
echo "  ZROB MIGAWKE I POWTORZ:"
echo "      python3 bakap.py && git push ..."
echo ""
echo "  Jesli naprawde wiesz, co robisz i migawka nie jest potrzebna:"
echo "      git push --no-verify ..."
echo ""
exit 1
